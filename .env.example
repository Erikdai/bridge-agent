# 任选一个提供商。两个都填时默认用 Anthropic；用 BRIDGE_PROVIDER 强制指定。
ANTHROPIC_API_KEY=
# 用户级 key（sk-ant-usr-...）需要指定工作区；控制台 Settings > Workspaces 里查看
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
# OpenAI 兼容接口（DeepSeek、Qwen、中转站等）填这里
OPENAI_BASE_URL=
OPENAI_MODEL=

# BRIDGE_PROVIDER=anthropic | openai
BRIDGE_PROVIDER=
# 不填则 anthropic 用 claude-opus-5-5，openai 用 OPENAI_MODEL
BRIDGE_MODEL=
# low | medium | high  （仅 Anthropic 生效）
BRIDGE_EFFORT=medium
BRIDGE_MAX_STEPS=40

# 用本机已安装的 Chrome/Edge 而不是 Playwright 自带的 Chromium：chrome | msedge
BRIDGE_BROWSER_CHANNEL=
# 连接到你已经登录好的浏览器（先用 --remote-debugging-port=9222 启动它）
BRIDGE_CDP_URL=

# 权限清单路径；不填则自动加载当前目录的 permissions.yaml（见 permissions.example.yaml）
BRIDGE_PERMISSIONS=
